// ============================================
// LOAN SUBSCRIPTION & PROVIDER MODELS
// ============================================

// ============================================
// LOAN PROVIDER MODEL (for loan subscription plans)
// ============================================

model LoanProvider {
  id                   String   @id @default(uuid())
  name                 String   @unique
  description          String?
  isActive             Boolean  @default(true)
  unlockFeeEnabled     Boolean  @default(false) // Admin decides whether an unlock fee applies
  unlockFeePercentage  Float?   // Fee percent when unlockFeeEnabled is true (no default)
  termsAndConditions   String?  @db.Text // Food Bundles loan terms & conditions
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  plans SubscriptionPlan[]

  @@index([name])
  @@index([isActive])
}

// ============================================
// LOAN TERMS ACCEPTANCE — first-time T&C per restaurant × provider
// ============================================

model LoanTermsAcceptance {
  id           String   @id @default(uuid())
  restaurantId String
  providerType String // TRADER | FOOD_BUNDLES
  providerId   String? // trader (Admin) id or loan provider id
  providerName String
  acceptedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, providerType, providerId])
  @@index([restaurantId])
}

// ============================================
// WALLET TRANSFER MODEL (for Kayko voucher amounts)
// ============================================

model WalletTransfer {
  id              String           @id @default(uuid())
  restaurantId    String
  voucherId       String?
  loanSessionId   String?
  amount          Float
  source          String           @default("VOUCHER_EXPIRY") // VOUCHER_EXPIRY, VOUCHER_UNUSED, MANUAL
  status          TransactionStatus @default(PENDING)
  transferredAt   DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  voucher      Voucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  loanSession  LoanSession?    @relation(fields: [loanSessionId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([voucherId])
  @@index([loanSessionId])
  @@index([status])
  @@index([createdAt])
}

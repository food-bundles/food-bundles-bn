// ============================================
// NEW VOUCHER CARD SYSTEM (PAN-based)
// ============================================

model VoucherCard {
  id                   String     @id @default(uuid())
  pan                  String     @unique // 16-digit permanent card number
  restaurantId         String     @unique // one card per restaurant
  status               CardStatus @default(ACTIVE)
  loanLimit            Float      @default(500000)
  unlockFeeEnabled     Boolean    @default(false) // Admin decides whether an unlock fee applies for this restaurant
  unlockFeePercentage  Float?     // Fee percent when unlockFeeEnabled is true (no default)
  riskScore            Float?
  issuedDate           DateTime   @default(now())
  issuedBy             String? // Admin ID who issued the card
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  issuer       Admin?       @relation("CardIssuer", fields: [issuedBy], references: [id])
  loanSessions LoanSession[]

  @@index([pan])
  @@index([restaurantId])
  @@index([status])
}

model CardEnrollmentRequest {
  id           String                  @id @default(uuid())
  restaurantId String                  @unique
  status       CardEnrollmentStatus    @default(PENDING)
  requestedAt  DateTime                @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}


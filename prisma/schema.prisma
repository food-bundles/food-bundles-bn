  @@index([restaurantId])
}

model LoanSession {
  id                  String            @id @default(uuid())
  rrn                 String            @unique // Retrieval Reference Number
  cardId              String
  restaurantId        String
  requestedAmount     Float
  approvedAmount      Float?
  approvalPercentage  Float?            @default(100)
  unlockFeePercentage Float?            // Effective fee percent snapshot at approval (null = no fee)
  unlockFee           Float?
  unlockStatus        UnlockStatus      @default(LOCKED)
  unlockPaidAt        DateTime?
  amountUsed          Float             @default(0)
  amountRepaid        Float             @default(0)
  outstandingAmount   Float             @default(0)
  status              LoanSessionStatus @default(REQUESTED)
  purpose             String?
  notes               String?
  repaymentDays       Int?
  dueDate             DateTime?
  approvedBy          String?
  fundingTraderId     String?
  loanProviderType    String?            // TRADER | FOOD_BUNDLES — provider chosen by the restaurant
  requestedAt         DateTime          @default(now())
  approvedAt          DateTime?
  unlockedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  card           VoucherCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  approver       Admin?               @relation("SessionApprover", fields: [approvedBy], references: [id])
  fundingTrader  Admin?               @relation("SessionFundingTrader", fields: [fundingTraderId], references: [id])
  unlockPayments UnlockFeePayment[]
  authorizations SessionAuthorization[]
  walletTransfers WalletTransfer[]

  @@index([rrn])
  @@index([cardId])
  @@index([restaurantId])
  @@index([status])
  @@index([unlockStatus])
}

model UnlockFeePayment {
  id              String        @id @default(uuid())
  sessionId       String
  amount          Float
  paymentMethod   String
  paymentReference String?
  phoneNumber     String?
  txRef           String?       @unique
  flwRef          String?
  flwStatus       String?
  transactionId   String?
  status          PaymentStatus @default(PENDING)
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  session LoanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([txRef])
}

model SessionAuthorization {
  id                String   @id @default(uuid())
  stan              String   @unique // System Trace Audit Number
  sessionId         String
  transactionAmount Float
  posTerminal       String?
  responseStatus    String   @default("APPROVED")
  createdAt         DateTime @default(now())

  session LoanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([stan])
  @@index([sessionId])
}


model POSSale {
  id            String     @id @default(uuid())
  restaurantId  String
  totalAmount   Float
  paymentMethod String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
}

model SubscriptionPlan {
  id                 String                   @id @default(uuid())
  name               String                   @unique
  description        String?
  price              Float
  duration           Int
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  features           String[]
  advertisingAccess  Boolean                  @default(false)
  freeDelivery       Boolean                  @default(false)
  receiveEBM         Boolean                  @default(false)
  stablePricing      Boolean                  @default(false)
  voucherAccess      Boolean                  @default(false)
  voucherPaymentDays Int                      @default(30)
  otherServices      Boolean                  @default(false)
  subscriptions      RestaurantSubscription[]

  @@index([isActive])
  @@index([name])
}

model RestaurantSubscription {
  id            String                @id @default(uuid())
  restaurantId  String?
  planId        String
  status        SubscriptionStatus    @default(ACTIVE)
  startDate     DateTime              @default(now())
  endDate       DateTime
  autoRenew     Boolean               @default(true)
  paymentStatus PaymentStatus         @default(PENDING)
  txRef         String?               @unique
  flwRef        String?
  transactionId String?
  amountPaid    Float?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  farmerId      String?
  paymentMethod String?
  farmer        Farmer?               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan      @relation(fields: [planId], references: [id])
  restaurant    Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  history       SubscriptionHistory[]
  payments      SubscriptionPayment[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model SubscriptionPayment {
  id             String                 @id @default(uuid())
  subscriptionId String
  amount         Float
  paymentStatus  PaymentStatus          @default(PENDING)
  txRef          String?                @unique
  flwRef         String?
  transactionId  String?
  flwStatus      String?
  flwMessage     String?
  paidAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  paymentMethod  String
  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentStatus])
  @@index([txRef])
}

model SubscriptionHistory {
  id             String                 @id @default(uuid())
  subscriptionId String
  action         SubscriptionAction
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus?
  oldPlanId      String?
  newPlanId      String?
  reason         String?
  performedBy    String?
  createdAt      DateTime               @default(now())
  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([action])
  @@index([createdAt])
}

model Voucher {
  id                 String               @id @default(uuid())
  voucherCode        String               @unique
  voucherType        VoucherType
  discountPercentage Float
  creditLimit        Float
  totalCredit        Float
  usedCredit         Float                @default(0)
  remainingCredit    Float
  status             VoucherStatus        @default(ACTIVE)
  expiryDate         DateTime?
  issuedDate         DateTime             @default(now())
  restaurantId       String?
  loanId             String?
  serviceFeeRate     Float                @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  usedAt             DateTime?
  currency           VoucherCurrency      @default(RWF)
  approvedBy         String?
  repaymentDays      Int                  @default(7)
  farmerId           String?
  paidAmount         Float                @default(0)
  remainingAmount    Float                @default(0)
  orders             Order[]
  approver           Admin?               @relation(fields: [approvedBy], references: [id])
  farmer             Farmer?              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  loan               LoanApplication?     @relation(fields: [loanId], references: [id])
  restaurant         Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  penalties          VoucherPenalty[]
  repayments         VoucherRepayment[]
  transactions       VoucherTransaction[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([voucherCode])
  @@index([loanId])
}

model LoanApplication {
  id               String             @id @default(uuid())
  restaurantId     String?
  requestedAmount  Float
  purpose          String?
  status           LoanStatus         @default(PENDING)
  approvedAmount   Float?
  approvedBy       String?
  disbursementDate DateTime?
  repaymentDueDate DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  approvedAt       DateTime?
  repaymentDays    Int?
  farmerId         String?
  managedBy        String?
  approver         Admin?             @relation("LoanApprover", fields: [approvedBy], references: [id])
  farmer           Farmer?            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  manager          Admin?             @relation("LoanManager", fields: [managedBy], references: [id])
  restaurant       Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  vouchers         Voucher[]
  repayments       VoucherRepayment[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([approvedBy])
}

model VoucherTransaction {
  id                 String      @id @default(uuid())
  voucherId          String
  orderId            String
  restaurantId       String?
  originalAmount     Float
  discountPercentage Float
  discountAmount     Float
  amountCharged      Float
  serviceFee         Float
  totalDeducted      Float
  transactionDate    DateTime    @default(now())
  createdAt          DateTime    @default(now())
  farmerId           String?
  farmer             Farmer?     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant         Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  voucher            Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([orderId])
  @@index([restaurantId])
  @@index([farmerId])
  @@index([transactionDate])
}

model VoucherRepayment {
  id                    String          @id @default(uuid())
  voucherId             String?
  restaurantId          String?
  loanId                String
  amount                Float
  paymentReference      String?
  allocatedToPrincipal  Float
  allocatedToServiceFee Float
  allocatedToPenalty    Float
  paymentDate           DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  farmerId              String?
  paymentMethod         String
  farmer                Farmer?         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  loan                  LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  restaurant            Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  voucher               Voucher?        @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@index([restaurantId])
  @@index([farmerId])
  @@index([loanId])
  @@index([paymentDate])
}

model VoucherPenalty {
  id            String        @id @default(uuid())
  voucherId     String
  restaurantId  String?
  penaltyAmount Float
  daysOverdue   Int
  penaltyRate   Float
  reason        String?
  status        PenaltyStatus @default(PENDING)
  appliedDate   DateTime      @default(now())
  paidDate      DateTime?
  createdAt     DateTime      @default(now())
  farmerId      String?
  farmer        Farmer?       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  restaurant    Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  voucher       Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([appliedDate])
}

model Post {
  id           String     @id @default(uuid())
  restaurantId String
  content      String
  images       String[]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  videos       String[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([isActive])
  @@index([createdAt])
}

model OTP {
  id        String     @id @default(uuid())
  phone     String
  otp       String
  purpose   OTPPurpose
  verified  Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
}

model Notification {
  id         String             @id @default(uuid())
  title      String
  message    String
  eventType  NotificationEvent
  targetType NotificationTarget
  targetId   String?
  targetRole Role?
  isRead     Boolean            @default(false)
  metadata   Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([targetType])
  @@index([targetId])
  @@index([targetRole])
  @@index([eventType])
  @@index([isRead])
  @@index([createdAt])
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  role      Role
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model TraderTransaction {
  id               String                @id @default(uuid())
  traderId         String
  type             TraderTransactionType
  amount           Float
  orderId          String?
  voucherId        String?
  loanId           String?
  reference        String?
  isCommissionPaid Boolean               @default(false)
  commissionRate   Float?
  description      String?
  metadata         Json?
  status           TransactionStatus     @default(COMPLETED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  trader           Admin                 @relation("TraderTransactionHistory", fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([type])
  @@index([orderId])
  @@index([voucherId])
  @@index([loanId])
  @@index([isCommissionPaid])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("unread")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_submissions")
}

model PromoCode {
  id                    String        @id @default(uuid())
  code                  String        @unique
  name                  String
  description           String?
  type                  PromoCodeType
  discountType          DiscountType  @default(PERCENTAGE)
  discountValue         Float
  isReusable            Boolean       @default(true)
  maxUsageCount         Int?
  currentUsageCount     Int           @default(0)
  maxUsagePerUser       Int?
  minOrderAmount        Float?
  minItemQuantity       Int?
  applyToAllProducts    Boolean       @default(true)
  applicableProductIds  String[]
  applicableCategoryIds String[]
  isActive              Boolean       @default(true)
  startDate             DateTime?
  expiryDate            DateTime?
  usageHistory          Json?
  excludedRestaurants   Json?
  restaurantUsageCount  Json?
  createdBy             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  includedRestaurants   Json?
  admin                 Admin?        @relation(fields: [createdBy], references: [id])

  @@index([code])
  @@index([type])
  @@index([isActive])
  @@index([expiryDate])
  @@index([startDate])
  @@index([createdBy])
}

model DelegationHistory {
  id         String    @id @default(uuid())
  walletId   String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())
  wallet     Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([startedAt])
  @@index([endedAt])
}


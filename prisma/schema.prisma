model PaymentMethodConfig {
  id                         String   @id @default(uuid())
  name                       String   @unique
  description                String?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  createdBy                  String
  tableTronicPaymentMethodId Int?     @unique
  orders                     Order[]
  admin                      Admin    @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([isActive])
  @@index([createdBy])
}

model ProductUnit {
  id                String    @id @default(uuid())
  name              String    @unique
  description       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  tableTronicUnitId Int?      @unique
  Product           Product[]
  admin             Admin     @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([isActive])
}

model ProductCategory {
  id                    String             @id @default(uuid())
  name                  String             @unique
  description           String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  createdBy             String
  tableTronicCategoryId Int?               @unique
  farmerSubmissions     FarmerSubmission[]
  products              Product[]
  admin                 Admin              @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([isActive])
}

model Cart {
  id           String     @id @default(uuid())
  restaurantId String
  totalAmount  Float      @default(0)
  status       CartStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orders       Order[]

  @@index([restaurantId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Float
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                  String               @id @default(uuid())
  restaurantId        String
  logisticsId         String?
  orderNumber         String               @unique
  status              OrderStatus          @default(PENDING)
  totalAmount         Float
  cartId              String?
  billingName         String?
  billingEmail        String?
  billingPhone        String?
  billingAddress      String?
  notes               String?
  requestedDelivery   DateTime?
  estimatedDelivery   DateTime?
  actualDelivery      DateTime?
  paymentStatus       PaymentStatus        @default(PENDING)
  paymentReference    String?
  paymentProvider     String?              @default("FLUTTERWAVE")
  paymentType         String?
  txRef               String?              @unique
  flwRef              String?
  txOrderId           String?
  currency            String?              @default("RWF")
  clientIp            String?
  deviceFingerprint   String?
  narration           String?
  transferReference   String?
  transferAccount     String?
  transferBank        String?
  transferNote        String?
  transferAmount      Float?
  network             String?
  voucher             String?
  cardNumber          String?
  cardCVV             String?
  cardType            String?
  cardExpiryMonth     String?
  cardExpiryYear      String?
  cardPIN             String?
  redirectUrl         String?
  authorizationMode   String?
  transactionId       String?
  flwStatus           String?
  appFee              Float?
  merchantFee         Float?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paidAt              DateTime?
  voucherCode         String?
  voucherId           String?
  deliveryFee         Float                @default(0)
  packagingFee        Float                @default(0)
  orderedBy           String?
  ebmReference        String?
  paymentMethod       String?
  originalAmount      Float?
  DeliveryOTP         DeliveryOTP?
  cart                Cart?                @relation(fields: [cartId], references: [id])
  logistics           Admin?               @relation("LOGISTICS", fields: [logisticsId], references: [id])
  affiliator          Affiliator?          @relation(fields: [orderedBy], references: [id])
  paymentMethodConfig PaymentMethodConfig? @relation(fields: [paymentMethod], references: [name])
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  Voucher             Voucher?             @relation(fields: [voucherId], references: [id])
  OrderDelivery       OrderDelivery?
  orderItems          OrderItem[]
  VoucherTransaction  VoucherTransaction[]

  @@index([restaurantId])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([txRef])
  @@index([flwRef])
  @@index([transactionId])
  @@index([flwStatus])
  @@index([cartId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Float
  unitPrice   Float
  subtotal    Float
  unit        String
  images      String[]
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model DeliveryOTP {
  id        String   @id @default(uuid())
  orderId   String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([expiresAt])
}

model OrderDelivery {
  id           String         @id @default(uuid())
  orderId      String         @unique
  logisticsId  String
  status       DeliveryStatus @default(PENDING)
  otpVerified  Boolean        @default(false)
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  logistics    Admin          @relation(fields: [logisticsId], references: [id])
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([logisticsId])
  @@index([status])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Farmer {
  id    String  @id @default(uuid())
  phone String? @unique
  email String? @unique
  name  String?

  location String?
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  locationUpdatedAt DateTime?

  role              Role    @default(FARMER)
  preferredLanguage String? @default("KINY")
  password          String?

  phoneVerified  Boolean   @default(false)
  phoneChangedAt DateTime?

  accountLocked Boolean   @default(false)
  lockedUntil   DateTime?
  pinChangedAt  DateTime?

  smsNotifications      Boolean @default(false)
  notificationFrequency String?

  // Two-Factor Authentication
  twoFactorSecret      String?  @db.Text
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  submissions            FarmerSubmission[]
  FarmerSecurityEvent    FarmerSecurityEvent[]
  FarmerSecurityQuestion FarmerSecurityQuestion[]
  FarmerLoginAttempt     FarmerLoginAttempt[]
  FarmerSecurityAlert    FarmerSecurityAlert[]
  FarmerProfile          FarmerProfile?
  FarmerPrimaryCrop      FarmerPrimaryCrop[]
  SupportTicket          SupportTicket[]
  CallbackRequest        CallbackRequest[]
  Voucher                Voucher[]
  LoanApplication        LoanApplication[]
  VoucherTransaction     VoucherTransaction[]
  VoucherRepayment       VoucherRepayment[]
  VoucherPenalty         VoucherPenalty[]
  RestaurantSubscription RestaurantSubscription[]
}

model Restaurant {
  id    String  @id @default(uuid())
  name  String
  email String? @unique
  phone String? @unique
  tin   String  @unique

  location String?
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  password          String
  ussdPin           String? // Optional 4-digit PIN for USSD authentication
  role              Role    @default(RESTAURANT)
  verified          Boolean @default(false)
  agreed            Boolean @default(false)
  preferredLanguage String? @default("KINY")

  // Two-Factor Authentication
  twoFactorSecret      String?  @db.Text
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders             Order[]
  posSales           POSSale[]
  Cart               Cart[]
  Wallet             Wallet?
  subscriptions      RestaurantSubscription[]
  Voucher            Voucher[]
  LoanApplication    LoanApplication[]
  VoucherTransaction VoucherTransaction[]
  VoucherRepayment   VoucherRepayment[]
  VoucherPenalty     VoucherPenalty[]
  posts              Post[]
  affiliators        Affiliator[]
  walletTransactions WalletTransaction[]
}

model Affiliator {
  id           String  @id @default(uuid())
  name         String
  email        String? @unique
  phone        String? @unique
  restaurantId String
  password     String
  role         Role    @default(AFFILIATOR)

  // Two-Factor Authentication
  twoFactorSecret      String?  @db.Text
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders             Order[]
  walletTransactions WalletTransaction[]

  @@index([restaurantId])
}

model FarmerSubmission {
  id                   String                @id @default(uuid())
  farmerId             String
  productName          String
  submittedQty         Float?
  acceptedQty          Float?
  totalAmount          Float?
  categoryId           String?
  status               SubmissionStatus      @default(PENDING)
  farmerFeedbackStatus FarmerFeedbackStatus? @default(PENDING)
  farmerFeedbackAt     DateTime?
  farmerFeedbackNotes  String?
  farmerCounterOffer   Float? // If farmer wants different price
  farmerCounterQty     Float? // If farmer wants different quantity
  feedbackDeadline     DateTime? // Deadline for farmer response
  aggregatorId         String?
  submittedAt          DateTime              @default(now())
  verifiedAt           DateTime?
  paymentMethod        String?
  approvedAt           DateTime?
  paidAt               DateTime?
  acceptedPrice        Float?
  approvedProductId    String?
  wishedPrice          Float?

  location String?
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  approvedProduct Product?         @relation(fields: [approvedProductId], references: [id])
  farmer          Farmer           @relation(fields: [farmerId], references: [id])
  aggregator      Admin?           @relation("Aggregator", fields: [aggregatorId], references: [id])
  category        ProductCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FarmerSecurityEvent {
  id          String   @id @default(uuid())
  farmerId    String
  eventType   String // PIN_CHANGE, PHONE_CHANGE, LOGIN_ATTEMPT, etc.
  description String?
  ipAddress   String?
  deviceInfo  String?
  createdAt   DateTime @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([eventType])
}

model FarmerSecurityQuestion {
  id         String   @id @default(uuid())
  farmerId   String
  question   String
  answerHash String
  createdAt  DateTime @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
}

model FarmerLoginAttempt {
  id          String   @id @default(uuid())
  farmerId    String
  successful  Boolean
  attemptTime DateTime
  deviceInfo  String?

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([attemptTime])
}

model FarmerSecurityAlert {
  id          String   @id @default(uuid())
  farmerId    String
  alertType   String
  description String
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([severity])
}

model FarmerProfile {
  id                     String   @id @default(uuid())
  farmerId               String   @unique
  farmSize               Float?
  farmSizeUnit           String? // HECTARES, ACRES
  experienceYears        Int?
  cooperativeMember      Boolean?
  cooperativeName        String?
  certifications         String[]
  farmingMethod          String? // ORGANIC, CONVENTIONAL, MIXED
  preferredPaymentMethod String? // MOBILE_MONEY, BANK_TRANSFER, CASH
  minimumOrderQuantity   Float?
  deliveryPreference     String? // FARM_PICKUP, COOPERATIVE_CENTER, MARKET_DELIVERY
  maxDeliveryDistance    Float?
  defaultLocation        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
}

model FarmerPrimaryCrop {
  id              String   @id @default(uuid())
  farmerId        String
  productId       String
  seasonal        Boolean  @default(false)
  defaultQuantity Float
  harvestMonths   String[]
  createdAt       DateTime @default(now())

  farmer  Farmer  @relation(fields: [farmerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([farmerId])
  @@index([productId])
}

model SupportTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  farmerId     String
  category     String // TECHNICAL, PAYMENT, ACCOUNT, GENERAL
  description  String
  priority     String // LOW, MEDIUM, HIGH, URGENT
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmer    Farmer            @relation(fields: [farmerId], references: [id])
  responses SupportResponse[]

  @@index([farmerId])
  @@index([status])
  @@index([ticketNumber])
}

model SupportResponse {
  id        String   @id @default(uuid())
  ticketId  String
  message   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model CallbackRequest {
  id            String   @id @default(uuid())
  farmerId      String
  phoneNumber   String
  preferredTime String
  issue         String
  status        String   @default("PENDING") // PENDING, SCHEDULED, COMPLETED
  createdAt     DateTime @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([status])
}

model Admin {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone String? @unique

  agreed   Boolean  @default(false)

  location String?
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  // Two-Factor Authentication
  twoFactorSecret      String?  @db.Text
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  aggregatorAssignments    FarmerSubmission[]    @relation("Aggregator")
  logisticsAssignments     Order[]               @relation("LOGISTICS")
  products                 Product[]
  productCategories        ProductCategory[]
  productUnits             ProductUnit[]
  paymentMethods           PaymentMethodConfig[]
  approvedLoans            LoanApplication[]     @relation("LoanApprover")
  managedLoans             LoanApplication[]     @relation("LoanManager")
  OrderDelivery            OrderDelivery[]
  promoCodes               PromoCode[]
  walletTransactions       WalletTransaction[]   @relation("WalletTransactionAdmin")
  Voucher                  Voucher[]
  traderWallet             Wallet?               @relation("TraderWallet")
  traderTransactions       WalletTransaction[]   @relation("TraderTransactions")
  traderTransactionHistory TraderTransaction[]   @relation("TraderTransactionHistory")
  approvedWithdrawals      WalletTransaction[]   @relation("WithdrawApprover")
  Market                   Market[]
  MarketPriceHistory       MarketPriceHistory[]
  NewsletterCampaign       NewsletterCampaign[]
}

model Product {
  id                   String               @id @default(uuid())
  tableTronicProductId Int?                 @unique @map("tableTronicProductId")
  unitPrice            Float
  restaurantPrice      Float? // Price for restaurant users
  hotelPrice           Float? // Price for hotel users
  purchasePrice        Float
  unit                 String
  unitId               String?
  createdAt            DateTime             @default(now())
  bonus                Int
  createdBy            String
  expiryDate           DateTime?
  images               String[]
  quantity             Float
  sku                  String               @unique
  updatedAt            DateTime             @updatedAt
  categoryId           String
  productName          String               @unique
  status               ProductStatus        @default(ACTIVE)
  inactiveReason       String?
  province             String?
  district             String?
  sector               String?
  cell                 String?
  village              String?
  farmerSubmissions    FarmerSubmission[]
  orderItems           OrderItem[]
  admin                Admin                @relation(fields: [createdBy], references: [id])
  CartItem             CartItem[]
  category             ProductCategory      @relation(fields: [categoryId], references: [id])
  FarmerPrimaryCrop    FarmerPrimaryCrop[]
  productUnit          ProductUnit?         @relation(fields: [unitId], references: [id])
  marketPriceHistory   MarketPriceHistory[]
}

model PaymentMethodConfig {
  id                         String   @id @default(uuid())
  tableTronicPaymentMethodId Int?     @unique
  name                       String   @unique
  description                String?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  createdBy                  String

  // Relations
  admin  Admin   @relation(fields: [createdBy], references: [id])
  orders Order[]

  @@index([name])
  @@index([isActive])
  @@index([createdBy])
}

model ProductUnit {
  id                String   @id @default(uuid())
  tableTronicUnitId Int?     @unique
  name              String   @unique
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String

  // Relations
  admin   Admin     @relation(fields: [createdBy], references: [id])
  Product Product[]

  @@index([name])
  @@index([isActive])
}

model ProductCategory {
  id                    String   @id @default(uuid())
  tableTronicCategoryId Int?     @unique
  name                  String   @unique
  description           String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             String

  // Relations
  admin             Admin              @relation(fields: [createdBy], references: [id])
  products          Product[]
  farmerSubmissions FarmerSubmission[]

  @@index([name])
  @@index([isActive])
}

// Cart schema model - Prisma Schema for Cart Management
model Cart {
  id           String     @id @default(uuid())
  restaurantId String // Foreign key to Restaurant model
  totalAmount  Float      @default(0) // Total amount of all items in cart
  status       CartStatus @default(ACTIVE) // Cart status (ACTIVE, CHECKED_OUT, ABANDONED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartItems  CartItem[] // One cart can have many cart items
  orders     Order[] // Cart can have multiple orders created from it

  // Indexes for better performance
  @@index([restaurantId])
  @@index([status])
}

// Cart Item model to store individual items in the cart
model CartItem {
  id        String   @id @default(uuid())
  cartId    String // Foreign key to Cart model
  productId String // Foreign key to Product model
  quantity  Float // Quantity of the product
  unitPrice Float // Price per unit at the time of adding to cart
  subtotal  Float // quantity * unitPrice
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ensure unique product per cart (restaurant can't add same product multiple times)
  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

// ORDER model 
model Order {
  id             String      @id @default(uuid())
  restaurantId   String
  orderedBy      String?
  logisticsId    String?
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  totalAmount    Float
  originalAmount Float?

  // Cart reference 
  cartId String?

  // Billing information 
  billingName    String?
  billingEmail   String?
  billingPhone   String?
  billingAddress String?

  // Order notes and dates
  notes             String?
  requestedDelivery DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  deliveryFee       Float     @default(0)
  packagingFee      Float     @default(0)

  // Payment information
  paymentMethod    String?
  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?
  paymentProvider  String?       @default("FLUTTERWAVE")
  paymentType      String?

  // Enhanced Payment Fields 
  txRef             String? @unique
  flwRef            String?
  txOrderId         String?
  currency          String? @default("RWF")
  clientIp          String?
  deviceFingerprint String?
  narration         String?

  // Bank transfer specific fields
  transferReference String?
  transferAccount   String?
  transferBank      String?
  transferNote      String?
  transferAmount    Float?

  // Mobile money specific fields
  network     String? // Network provider (MTN, Airtel, etc.)
  voucherCode String?
  voucherId   String?
  voucher     String? // Voucher code

  // Card payment specific fields
  cardNumber      String?
  cardCVV         String?
  cardType        String?
  cardExpiryMonth String?
  cardExpiryYear  String?
  cardPIN         String?

  // Authorization and redirect information
  redirectUrl       String?
  authorizationMode String?

  // Transaction status and references
  transactionId String?
  ebmReference  String?

  // Response fields
  flwStatus   String?
  appFee      Float?
  merchantFee Float?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  // Relations
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  affiliator          Affiliator?          @relation(fields: [orderedBy], references: [id])
  orderItems          OrderItem[]
  logistics           Admin?               @relation("LOGISTICS", fields: [logisticsId], references: [id])
  cart                Cart?                @relation(fields: [cartId], references: [id])
  VoucherTransaction  VoucherTransaction[]
  Voucher             Voucher?             @relation(fields: [voucherId], references: [id])
  DeliveryOTP         DeliveryOTP?
  OrderDelivery       OrderDelivery?
  paymentMethodConfig PaymentMethodConfig? @relation(fields: [paymentMethod], references: [name])

  @@index([restaurantId])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([txRef])
  @@index([flwRef])
  @@index([transactionId])
  @@index([flwStatus])
  @@index([cartId])
}

// OrderItem model
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String? // Make this optional to allow SetNull
  productName String // Store product name at time of order
  quantity    Float
  unitPrice   Float // Store price at time of order
  subtotal    Float // quantity * unitPrice
  unit        String // Store unit at time of order
  images      String[] // Store images array at time of order
  category    String? // Store category name at time of order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model DeliveryOTP {
  id        String   @id @default(uuid())
  orderId   String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([expiresAt])
}

model OrderDelivery {
  id           String         @id @default(uuid())
  orderId      String         @unique
  logisticsId  String
  status       DeliveryStatus @default(PENDING)
  otpVerified  Boolean        @default(false)
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logistics Admin @relation(fields: [logisticsId], references: [id])

  @@index([orderId])
  @@index([logisticsId])
  @@index([status])
}

// Wallet model for managing user account balances
model Wallet {
  id                        String           @id @default(uuid())
  restaurantId              String?          @unique
  traderId                  String?          @unique
  balance                   Float            @default(0)
  pendingApprovedAmount     Float            @default(0) // Amount approved for active vouchers
  commissionEarned          Float            @default(0) // Total commission earned (separate from balance)
  commission                Float            @default(3.0) // Commission percentage (default 3% for NORMAL, 5% for FIXED)
  commissionMode            CommissionMode   @default(NORMAL) // NORMAL (per voucher) or FIXED (monthly)
  commissionModeChangedAt   DateTime? // When commission mode was last changed
  lastMonthlyCommissionDate DateTime? // Last date monthly commission was processed
  totalDeposited            Float            @default(0) // Total amount deposited (never decreases)
  pendingWithdrawBalance    Float            @default(0) // Pending withdraw from balance
  pendingWithdrawCommission Float            @default(0) // Pending withdraw from commission
  totalWithdrawn            Float            @default(0) // Total amount withdrawn
  canTradeOnBehalf          Boolean          @default(false) // Permission to trade on behalf
  delegationStatus          DelegationStatus @default(NORMAL) // Current delegation status
  delegationRequestedAt     DateTime? // When delegation was requested
  delegationApprovedAt      DateTime? // When delegation was approved
  delegationApprovedBy      String? // Admin ID who approved delegation
  delegationAcceptedAt      DateTime? // When trader accepted delegation
  currency                  String           @default("RWF")
  isActive                  Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  // Relations
  restaurant          Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  trader              Admin?              @relation("TraderWallet", fields: [traderId], references: [id], onDelete: Cascade)
  transactions        WalletTransaction[]
  delegationHistories DelegationHistory[]

  @@index([restaurantId])
  @@index([traderId])
  @@index([isActive])
}

// Wallet transaction model for tracking all wallet activities
model WalletTransaction {
  id              String                @id @default(uuid())
  walletId        String
  adminId         String?
  restaurantId    String?
  affiliatorId    String?
  traderId        String?
  type            WalletTransactionType
  amount          Float // Positive for credit, negative for debit
  previousBalance Float
  newBalance      Float
  description     String?
  reference       String? // Reference to related entity (order, etc.)

  // Integration fields for top-ups
  flwTxRef      String? @unique
  flwRef        String?
  flwStatus     String?
  flwMessage    String?
  paymentMethod String?
  externalTxId  String?

  // Withdraw fields
  withdrawType  WithdrawType?
  accountNumber String?
  accountName   String?
  otp           String?
  otpExpiresAt  DateTime?
  otpVerified   Boolean?      @default(false)
  approvedBy    String? // Admin ID who approved the withdraw
  approvedAt        DateTime? // When withdraw was approved (for 45-day countdown)
  paymentProofImage String? // Cloudinary URL of payment proof (screenshot/receipt)
  isReversed    Boolean       @default(false) // Track if transaction is a reversal

  status   TransactionStatus @default(PENDING)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  admin      Admin?      @relation("WalletTransactionAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  affiliator Affiliator? @relation(fields: [affiliatorId], references: [id], onDelete: Cascade)
  trader     Admin?      @relation("TraderTransactions", fields: [traderId], references: [id], onDelete: Cascade)
  approver   Admin?      @relation("WithdrawApprover", fields: [approvedBy], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([flwTxRef])
  @@index([adminId])
  @@index([restaurantId])
  @@index([affiliatorId])
  @@index([traderId])
}

model POSSale {
  id            String     @id @default(uuid())
  restaurantId  String
  totalAmount   Float
  paymentMethod String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
}

// Subscription Plan model
model SubscriptionPlan {
  id                 String   @id @default(uuid())
  name               String   @unique
  description        String?
  price              Float
  voucherAccess      Boolean  @default(false)
  voucherPaymentDays Int      @default(30) // Number of days for voucher payment
  freeDelivery       Boolean  @default(false)
  stablePricing      Boolean  @default(false)
  receiveEBM         Boolean  @default(false)
  advertisingAccess  Boolean  @default(false)
  otherServices      Boolean  @default(false)
  duration           Int // Duration in days
  features           String[] // Array of features included in the plan
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  subscriptions RestaurantSubscription[]

  @@index([isActive])
  @@index([name])
}

// Restaurant Subscription model
model RestaurantSubscription {
  id                String             @id @default(uuid())
  restaurantId      String?
  farmerId          String?
  planId            String
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime           @default(now())
  endDate           DateTime
  autoRenew         Boolean            @default(true)
  paymentMethod     String?
  paymentStatus     PaymentStatus      @default(PENDING)
  expiryWarningSent Boolean            @default(false)

  // Payment tracking
  txRef         String? @unique
  flwRef        String?
  transactionId String?
  amountPaid    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  restaurant Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer     Farmer?               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments   SubscriptionPayment[]
  history    SubscriptionHistory[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

// Subscription Payment model
model SubscriptionPayment {
  id             String        @id @default(uuid())
  subscriptionId String
  amount         Float
  paymentMethod  String
  paymentStatus  PaymentStatus @default(PENDING)

  // Payment integration fields
  txRef         String? @unique
  flwRef        String?
  transactionId String?
  flwStatus     String?
  flwMessage    String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  subscription RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentStatus])
  @@index([txRef])
}

// Subscription History model for tracking changes
model SubscriptionHistory {
  id             String              @id @default(uuid())
  subscriptionId String
  action         SubscriptionAction
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus?
  oldPlanId      String?
  newPlanId      String?
  reason         String?
  performedBy    String? // Admin ID who performed the action
  createdAt      DateTime            @default(now())

  // Relations
  subscription RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([action])
  @@index([createdAt])
}

model Voucher {
  id                 String      @id @default(uuid())
  voucherCode        String      @unique
  voucherType        VoucherType
  discountPercentage Float // 10, 20, 50, 80, 100

  // Credit limits
  creditLimit Float
  currency    VoucherCurrency @default(RWF)

  // Credit tracking
  totalCredit     Float
  usedCredit      Float @default(0)
  remainingCredit Float

  // Payment tracking
  paidAmount      Float @default(0)
  remainingAmount Float @default(0)

  // Commission tracking
  commission Float @default(0) // Commission amount saved when voucher is used

  // Status and dates
  status     VoucherStatus @default(ACTIVE)
  expiryDate DateTime?
  issuedDate DateTime      @default(now())
  approvedBy String?

  // Relations
  restaurantId String?
  farmerId     String?
  loanId       String?

  // Repayment days
  repaymentDays Int @default(7)

  // Service fee
  serviceFeeRate Float @default(0) // 0% service fee

  // Timestamps
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  restaurant   Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer       Farmer?              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  loan         LoanApplication?     @relation(fields: [loanId], references: [id])
  approver     Admin?               @relation(fields: [approvedBy], references: [id])
  transactions VoucherTransaction[]
  repayments   VoucherRepayment[]
  penalties    VoucherPenalty[]
  orders       Order[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([voucherCode])
  @@index([loanId])
}

model LoanApplication {
  id              String  @id @default(uuid())
  restaurantId    String?
  farmerId        String?
  requestedAmount Float
  purpose         String?

  // Repayment days (from voucher or explicitly set)
  repaymentDays Int?

  // Approval workflow
  status         LoanStatus @default(PENDING)
  approvedAmount Float?
  approvedBy     String? // Admin ID
  managedBy      String? // Admin ID who manage trader's account

  // Dates
  disbursementDate DateTime?
  repaymentDueDate DateTime? // Calculated based on repaymentDays

  // Additional info
  notes String?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  // Relations
  restaurant Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer     Farmer?            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  approver   Admin?             @relation("LoanApprover", fields: [approvedBy], references: [id])
  manager    Admin?             @relation("LoanManager", fields: [managedBy], references: [id])
  vouchers   Voucher[]
  repayments VoucherRepayment[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([approvedBy])
}

model VoucherTransaction {
  id           String  @id @default(uuid())
  voucherId    String
  orderId      String
  restaurantId String?
  farmerId     String?

  // Transaction amounts
  originalAmount     Float
  discountPercentage Float
  discountAmount     Float
  amountCharged      Float // After discount
  serviceFee         Float // 10% of amountCharged
  totalDeducted      Float // amountCharged + serviceFee

  // Timestamps
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relations
  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer     Farmer?     @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([orderId])
  @@index([restaurantId])
  @@index([farmerId])
  @@index([transactionDate])
}

model VoucherRepayment {
  id           String  @id @default(uuid())
  voucherId    String?
  restaurantId String?
  farmerId     String?
  loanId       String

  // Payment details
  amount           Float
  paymentMethod    String
  paymentReference String?

  // Allocation breakdown
  allocatedToPrincipal  Float
  allocatedToServiceFee Float
  allocatedToPenalty    Float

  // Timestamps
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  voucher    Voucher?        @relation(fields: [voucherId], references: [id])
  restaurant Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer     Farmer?         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  loan       LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([restaurantId])
  @@index([farmerId])
  @@index([loanId])
  @@index([paymentDate])
}

model VoucherPenalty {
  id           String  @id @default(uuid())
  voucherId    String
  restaurantId String?
  farmerId     String?

  // Penalty details
  penaltyAmount Float
  daysOverdue   Int
  penaltyRate   Float // e.g., 2% per month
  reason        String?

  // Status
  status PenaltyStatus @default(PENDING)

  // Timestamps
  appliedDate DateTime  @default(now())
  paidDate    DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer     Farmer?     @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([appliedDate])
}

model Post {
  id           String   @id @default(uuid())
  restaurantId String
  content      String
  images       String[]
  videos       String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([isActive])
  @@index([createdAt])
}

model OTP {
  id        String     @id @default(uuid())
  phone     String
  otp       String
  purpose   OTPPurpose
  verified  Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
}

model Notification {
  id         String             @id @default(uuid())
  title      String
  message    String
  eventType  NotificationEvent
  targetType NotificationTarget
  targetId   String? // Specific user ID when targetType is SPECIFIC_USER
  targetRole Role? // Role when targetType is ROLE_BASED
  isRead     Boolean            @default(false)
  metadata   Json? // Additional data related to the notification
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([targetType])
  @@index([targetId])
  @@index([targetRole])
  @@index([eventType])
  @@index([isRead])
  @@index([createdAt])
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  role      Role
  expiresAt DateTime // Valid for 24 hours
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model TraderTransaction {
  id       String                @id @default(uuid())
  traderId String
  type     TraderTransactionType
  amount   Float

  // Reference tracking
  orderId   String?
  voucherId String?
  loanId    String?
  reference String? // Generic reference field

  // Commission tracking
  isCommissionPaid Boolean @default(false)
  commissionRate   Float? // e.g., 0.05 for 5%

  description String?
  metadata    Json?
  status      TransactionStatus @default(COMPLETED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  trader Admin @relation("TraderTransactionHistory", fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([type])
  @@index([orderId])
  @@index([voucherId])
  @@index([loanId])
  @@index([isCommissionPaid])
  @@index([createdAt])
}

enum TraderTransactionType {
  LOAN_APPROVAL
  LOAN_REVERSAL
  COMMISSION_EARNED
  COMMISSION_PAID
  WALLET_TOPUP
  WALLET_DEBIT
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("unread") // unread, read, responded
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_submissions")
}

// ============================================
// PROMO CODE SCHEMA
// ============================================

model PromoCode {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String // Display name for the promo code
  description String? // Description of what the promo offers

  // Type and discount configuration
  type          PromoCodeType
  discountType  DiscountType  @default(PERCENTAGE)
  discountValue Float // percentage (0-100) or fixed amount in RWF

  // Usage limits and tracking
  isReusable        Boolean @default(true)
  maxUsageCount     Int? // null = unlimited global usage
  currentUsageCount Int     @default(0)
  maxUsagePerUser   Int? // null = unlimited per user

  // Minimum requirements
  minOrderAmount  Float? // Minimum total order amount to use promo
  minItemQuantity Int? // Minimum quantity of items

  // Application scope
  applyToAllProducts    Boolean  @default(true)
  applicableProductIds  String[] // Specific products (if not all)
  applicableCategoryIds String[] // Specific categories (if not all)

  // Validity period
  isActive   Boolean   @default(true)
  startDate  DateTime? // When promo becomes active
  expiryDate DateTime? // When promo expires

  // Usage tracking - stores JSON array of usage records
  usageHistory Json? // [{restaurantId, orderId, originalAmount, discountAmount, finalAmount, itemsDiscounted, usedAt}]

  // Exclusions - stores JSON array of excluded restaurants
  excludedRestaurants Json? // [{restaurantId, reason, excludedBy, excludedAt}]

  // Inclusions - stores JSON array of included restaurants for private promo codes
  includedRestaurants Json? // [{restaurantId, reason, includedBy, includedAt}]

  // Per-restaurant usage count tracking
  restaurantUsageCount Json? // {restaurantId: count}

  // Creator information
  createdBy String? // Admin ID who created the promo

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admin Admin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([type])
  @@index([isActive])
  @@index([expiryDate])
  @@index([startDate])
  @@index([createdBy])
}

// Delegation History - tracks all delegation control changes
model DelegationHistory {
  id         String    @id @default(uuid())
  walletId   String
  action     String    @default("REQUESTED") // "AUTO_DELEGATED", "REVOKED", "REQUESTED", "APPROVED", "ACCEPTED"
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  reason     String?
  approvedBy String?
  createdAt  DateTime  @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([startedAt])
  @@index([endedAt])
}

model NotificationRecipient {
  id          String               @id @default(uuid())
  name        String
  phoneNumber String
  category    NotificationCategory
  isActive    Boolean              @default(true)
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([phoneNumber])
}

// ============================================
// MARKET PRICE TRACKING SCHEMA
// ============================================

// External markets for price comparison
model Market {
  id        String   @id @default(uuid())
  name      String   @unique
  createdBy String
  location  String? // Can be street address or GPS coordinates
  province  String?
  district  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  priceHistory MarketPriceHistory[]
  admin        Admin                @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([province])
  @@index([district])
  @@index([isActive])
}

// Market price history for product comparison
model MarketPriceHistory {
  id           String   @id @default(uuid())
  productId    String // Our product ID for comparison
  marketId     String
  ourPrice     Float // Price from our database at the time
  marketPrice  Float // Price at the external market
  recordedBy   String
  recordedDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  admin   Admin   @relation(fields: [recordedBy], references: [id])

  @@index([productId])
  @@index([marketId])
  @@index([recordedDate])
  @@index([createdAt])
}

enum Role {
  FARMER
  RESTAURANT
  HOTEL
  ADMIN
  AGGREGATOR
  LOGISTICS
  AFFILIATOR
  TRADER
  SUPERUSER
  MARKET_PRICES
}

enum SubmissionStatus {
  PENDING
  VERIFIED
  APPROVED
  PAID
}

enum FarmerFeedbackStatus {
  PENDING // Farmer hasn't provided feedback yet
  ACCEPTED // Farmer accepted the purchase terms
  REJECTED // Farmer rejected the purchase terms
  EXTENDED // Farmer requested extension/negotiation
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

// Cart status enum
enum CartStatus {
  ACTIVE // Cart is active and can be modified
  CHECKED_OUT // Cart has been converted to an order
  ABANDONED // Cart has been abandoned (optional for cleanup)
}

// Payment status enum
enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  VOUCHER_CREDIT
}

// Order status enum
enum OrderStatus {
  PENDING // Order created, waiting for confirmation
  CONFIRMED // Order confirmed, being prepared
  PREPARING // Order is being prepared
  READY // Order ready for pickup/delivery
  IN_TRANSIT // Order out for delivery
  DELIVERED // Order successfully delivered
  CANCELLED // Order cancelled
  REFUNDED // Order refunded
}

enum DeliveryStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Enum for wallet transaction types
enum WalletTransactionType {
  TOP_UP
  PAYMENT
  REFUND
  ADJUSTMENT // Manual adjustment by admin
  WITHDRAWAL
  TRADING
  REVERSAL // For returning pending amounts from expired vouchers
}

enum WithdrawType {
  BALANCE
  COMMISSION
}

// Enum for transaction status
enum TransactionStatus {
  PENDING
  PROCESSING
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

enum SubscriptionAction {
  CREATED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCELLED
  SUSPENDED
  REACTIVATED
  EXPIRED
  ROLLBACK
}

enum VoucherType {
  DISCOUNT_10
  DISCOUNT_20
  DISCOUNT_50
  DISCOUNT_80
  DISCOUNT_100
}

enum VoucherCurrency {
  RWF
  USD
  EUR
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
  SUSPENDED
  SETTLED
  MATURED
}

enum LoanStatus {
  ACCEPTED
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum PenaltyStatus {
  PENDING
  PAID
  WAIVED
}

enum OTPPurpose {
  RESTAURANT_SIGNUP
  VOUCHER_CHECKOUT
  ADMIN_WALLET_OPERATION
}

enum NotificationEvent {
  NEW_ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_DELIVERED
  PAYMENT_PROCESSED
  PAYMENT_FAILED
  USER_SIGNUP
  PRODUCT_APPROVED
  PRODUCT_PRICE_UPDATED
  VOUCHER_APPLIED
  VOUCHER_ISSUED
  SUBSCRIPTION_EXPIRED
  LOW_STOCK_ALERT
  SYSTEM_MAINTENANCE
}

enum NotificationTarget {
  SPECIFIC_USER
  ROLE_BASED
  ALL_USERS
}

// ============================================
// PROMO CODE ENUMS
// ============================================

enum PromoCodeType {
  PUBLIC // Available to all users
  SUBSCRIBERS // Only for users with active subscriptions
  EXCEPTIONAL // Available to all except explicitly excluded users
}

enum DiscountType {
  PERCENTAGE // Discount as percentage (e.g., 10% off)
  FIXED_AMOUNT // Fixed amount discount (e.g., 5000 RWF off)
}

enum DelegationStatus {
  NORMAL // No delegation active or requested
  PENDING // Trader requested delegation
  APPROVED // Admin approved, waiting for trader acceptance
  ACCEPTED // Trader accepted, delegation is active (used for both manual and auto-delegation)
}

enum NotificationCategory {
  MATURED_VOUCHERS
  EXPIRED_VOUCHERS
  LOW_STOCK
  PAYMENT_ISSUES
  SYSTEM_ALERTS
}

// ============================================
// NEWSLETTER SCHEMA
// ============================================

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  phone        String?
  restaurantId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([createdAt])
}

model NewsletterCampaign {
  id             String           @id @default(uuid())
  subject        String
  content        String
  status         NewsletterStatus @default(DRAFT)
  sentAt         DateTime?
  sentBy         String
  recipientCount Int              @default(0)
  openCount      Int              @default(0)
  clickCount     Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  admin Admin @relation(fields: [sentBy], references: [id])

  @@index([status])
  @@index([sentAt])
  @@index([createdAt])
}

enum NewsletterStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum CommissionMode {
  NORMAL
  FIXED
}

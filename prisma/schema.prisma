generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

model Farmer {
  id                     String                   @id @default(uuid())
  phone                  String?                  @unique
  email                  String?                  @unique
  name                   String?
  location               String?
  province               String?
  district               String?
  sector                 String?
  cell                   String?
  village                String?
  locationUpdatedAt      DateTime?
  role                   Role                     @default(FARMER)
  preferredLanguage      String?                  @default("KINY")
  password               String?
  phoneVerified          Boolean                  @default(false)
  phoneChangedAt         DateTime?
  accountLocked          Boolean                  @default(false)
  lockedUntil            DateTime?
  pinChangedAt           DateTime?
  smsNotifications       Boolean                  @default(false)
  notificationFrequency  String?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean                  @default(false)
  twoFactorBackupCodes   String[]                 @default([])
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  CallbackRequest        CallbackRequest[]
  FarmerLoginAttempt     FarmerLoginAttempt[]
  FarmerPrimaryCrop      FarmerPrimaryCrop[]
  FarmerProfile          FarmerProfile?
  FarmerSecurityAlert    FarmerSecurityAlert[]
  FarmerSecurityEvent    FarmerSecurityEvent[]
  FarmerSecurityQuestion FarmerSecurityQuestion[]
  submissions            FarmerSubmission[]
  LoanApplication        LoanApplication[]
  RestaurantSubscription RestaurantSubscription[]
  SupportTicket          SupportTicket[]
  Voucher                Voucher[]
  VoucherPenalty         VoucherPenalty[]
  VoucherRepayment       VoucherRepayment[]
  VoucherTransaction     VoucherTransaction[]
}

model Restaurant {
  id    String  @id @default(uuid())
  name  String
  email String? @unique
  phone String? @unique
  tin   String  @unique

  location String?
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  password          String
  ussdPin           String? // Optional 4-digit PIN for USSD authentication
  role              Role    @default(RESTAURANT)
  verified          Boolean @default(false)
  agreed            Boolean @default(false)
  preferredLanguage String? @default("KINY")

  // Two-Factor Authentication
  twoFactorSecret      String?  @db.Text
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders             Order[]
  posSales           POSSale[]
  Cart               Cart[]
  Wallet             Wallet?
  subscriptions      RestaurantSubscription[]
  Voucher            Voucher[]
  LoanApplication    LoanApplication[]
  VoucherTransaction VoucherTransaction[]
  VoucherRepayment   VoucherRepayment[]
  VoucherPenalty     VoucherPenalty[]
  posts              Post[]
  affiliators        Affiliator[]
  walletTransactions WalletTransaction[]
  VoucherCard        VoucherCard?
  LoanSession        LoanSession[]
  CardEnrollmentRequest CardEnrollmentRequest?
  KycConsent            KycConsent?
  WalletTransfer     WalletTransfer[]
  VoucherCreditTopUp VoucherCreditTopUp[]
  LoanTermsAcceptance LoanTermsAcceptance[]
}

model Affiliator {
  id                   String              @id @default(uuid())
  name                 String
  email                String?             @unique
  phone                String?             @unique
  restaurantId         String
  password             String
  role                 Role                @default(AFFILIATOR)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean             @default(false)
  twoFactorBackupCodes String[]            @default([])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  restaurant           Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders               Order[]
  walletTransactions   WalletTransaction[]

  @@index([restaurantId])
}

model FarmerSubmission {
  id                   String                @id @default(uuid())
  farmerId             String
  productName          String
  submittedQty         Float?
  acceptedQty          Float?
  totalAmount          Float?
  categoryId           String?
  status               SubmissionStatus      @default(PENDING)
  farmerFeedbackStatus FarmerFeedbackStatus? @default(PENDING)
  farmerFeedbackAt     DateTime?
  farmerFeedbackNotes  String?
  farmerCounterOffer   Float?
  farmerCounterQty     Float?
  feedbackDeadline     DateTime?
  aggregatorId         String?
  submittedAt          DateTime              @default(now())
  verifiedAt           DateTime?
  paymentMethod        String?
  approvedAt           DateTime?
  paidAt               DateTime?
  acceptedPrice        Float?
  approvedProductId    String?
  wishedPrice          Float?
  location             String?
  province             String?
  district             String?
  sector               String?
  cell                 String?
  village              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  aggregator           Admin?                @relation("Aggregator", fields: [aggregatorId], references: [id])
  approvedProduct      Product?              @relation(fields: [approvedProductId], references: [id])
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  farmer               Farmer                @relation(fields: [farmerId], references: [id])
}

model FarmerSecurityEvent {
  id          String   @id @default(uuid())
  farmerId    String
  eventType   String
  description String?
  ipAddress   String?
  deviceInfo  String?
  createdAt   DateTime @default(now())
  farmer      Farmer   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([eventType])
}

model FarmerSecurityQuestion {
  id         String   @id @default(uuid())
  farmerId   String
  question   String
  answerHash String
  createdAt  DateTime @default(now())
  farmer     Farmer   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
}

model FarmerLoginAttempt {
  id          String   @id @default(uuid())
  farmerId    String
  successful  Boolean
  attemptTime DateTime
  deviceInfo  String?
  farmer      Farmer   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([attemptTime])
}

model FarmerSecurityAlert {
  id          String   @id @default(uuid())
  farmerId    String
  alertType   String
  description String
  severity    String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  farmer      Farmer   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([severity])
}

model FarmerProfile {
  id                     String   @id @default(uuid())
  farmerId               String   @unique
  farmSize               Float?
  farmSizeUnit           String?
  experienceYears        Int?
  cooperativeMember      Boolean?
  cooperativeName        String?
  certifications         String[]
  farmingMethod          String?
  preferredPaymentMethod String?
  minimumOrderQuantity   Float?
  deliveryPreference     String?
  maxDeliveryDistance    Float?
  defaultLocation        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  farmer                 Farmer   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
}

model FarmerPrimaryCrop {
  id              String   @id @default(uuid())
  farmerId        String
  productId       String
  seasonal        Boolean  @default(false)
  defaultQuantity Float
  harvestMonths   String[]
  createdAt       DateTime @default(now())
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@index([farmerId])
  @@index([productId])
}

model SupportTicket {
  id           String            @id @default(uuid())
  ticketNumber String            @unique
  farmerId     String
  category     String
  description  String
  priority     String
  status       String            @default("OPEN")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  responses    SupportResponse[]
  farmer       Farmer            @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([status])
  @@index([ticketNumber])
}

model SupportResponse {
  id        String        @id @default(uuid())
  ticketId  String
  message   String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model CallbackRequest {
  id            String   @id @default(uuid())
  farmerId      String
  phoneNumber   String
  preferredTime String
  issue         String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  farmer        Farmer   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([status])
}

model Admin {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone String? @unique

  agreed   Boolean  @default(false)

  termsAndConditions String? @db.Text // Trader's loan terms & conditions
  loanTermsAndConditions String? @db.Text // Trader's own loan terms that restaurants sign when requesting a loan
  requiresSubscription Boolean @default(false) // Restaurants need an active subscription to get a loan from this trader

  location String?
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  // Two-Factor Authentication
  twoFactorSecret      String?  @db.Text
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  aggregatorAssignments    FarmerSubmission[]    @relation("Aggregator")
  approvedLoans            LoanApplication[]     @relation("LoanApprover")
  managedLoans             LoanApplication[]     @relation("LoanManager")
  Market                   Market[]
  MarketPriceHistory       MarketPriceHistory[]
  NewsletterCampaign       NewsletterCampaign[]
  issuedCards              VoucherCard[]         @relation("CardIssuer")
  approvedSessions         LoanSession[]         @relation("SessionApprover")
  fundedSessions           LoanSession[]         @relation("SessionFundingTrader")
}

model Product {
  id                   String               @id @default(uuid())
  tableTronicProductId Int?                 @unique @map("tableTronicProductId")
  unitPrice            Float
  restaurantPrice      Float?
  hotelPrice           Float?
  purchasePrice        Float
  unit                 String
  unitId               String?
  createdAt            DateTime             @default(now())
  bonus                Int
  createdBy            String
  expiryDate           DateTime?
  images               String[]
  quantity             Float
  sku                  String               @unique
  updatedAt            DateTime             @updatedAt
  categoryId           String
  productName          String               @unique
  status               ProductStatus        @default(ACTIVE)
  inactiveReason       String?
  province             String?
  district             String?
  sector               String?
  cell                 String?
  village              String?
  CartItem             CartItem[]
  FarmerPrimaryCrop    FarmerPrimaryCrop[]
  farmerSubmissions    FarmerSubmission[]
  marketPriceHistory   MarketPriceHistory[]
  orderItems           OrderItem[]
  customerTypePrices   ProductCustomerPrice[]
  category             ProductCategory      @relation(fields: [categoryId], references: [id])
  admin                Admin                @relation(fields: [createdBy], references: [id])
  productUnit          ProductUnit?         @relation(fields: [unitId], references: [id])
}

model CustomerType {
  id                  String                 @id @default(uuid())
  name                String                 @unique
  description         String?
  isActive            Boolean                @default(true)
  createdBy           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  productCustomerPrices ProductCustomerPrice[]
  restaurants         Restaurant[]

  @@index([name])
  @@index([isActive])
}

model ProductCustomerPrice {
  id             String       @id @default(uuid())
  productId      String
  customerTypeId String
  price          Float
  purchasePrice  Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Cascade)

  @@unique([productId, customerTypeId])
  @@index([productId])
  @@index([customerTypeId])
}


model PaymentMethodConfig {
  id                         String   @id @default(uuid())
  tableTronicPaymentMethodId Int?     @unique
  name                       String   @unique
  description                String?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  createdBy                  String
  orders                     Order[]
  admin                      Admin    @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([isActive])
  @@index([createdBy])
}

model ProductUnit {
  id                String    @id @default(uuid())
  tableTronicUnitId Int?      @unique
  name              String    @unique
  description       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  Product           Product[]
  admin             Admin     @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([isActive])
}

model ProductCategory {
  id                    String             @id @default(uuid())
  tableTronicCategoryId Int?               @unique
  name                  String             @unique
  description           String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  createdBy             String
  farmerSubmissions     FarmerSubmission[]
  products              Product[]
  admin                 Admin              @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([isActive])
}

model Cart {
  id           String     @id @default(uuid())
  restaurantId String
  totalAmount  Float      @default(0)
  status       CartStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orders       Order[]

  @@index([restaurantId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Float
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                  String               @id @default(uuid())
  restaurantId        String
  orderedBy           String?
  logisticsId         String?
  orderNumber         String               @unique
  status              OrderStatus          @default(PENDING)
  totalAmount         Float
  originalAmount      Float?
  cartId              String?
  billingName         String?
  billingEmail        String?
  billingPhone        String?
  billingAddress      String?
  notes               String?
  requestedDelivery   DateTime?
  estimatedDelivery   DateTime?
  actualDelivery      DateTime?
  deliveryFee         Float                @default(0)
  packagingFee        Float                @default(0)
  paymentMethod       String?
  paymentStatus       PaymentStatus        @default(PENDING)
  paymentReference    String?
  paymentProvider     String?              @default("FLUTTERWAVE")
  paymentType         String?
  txRef               String?              @unique
  flwRef              String?
  txOrderId           String?
  currency            String?              @default("RWF")
  clientIp            String?
  deviceFingerprint   String?
  narration           String?
  transferReference   String?
  transferAccount     String?
  transferBank        String?
  transferNote        String?
  transferAmount      Float?
  network             String?
  voucherCode         String?
  voucherId           String?
  voucher             String?
  cardNumber          String?
  cardCVV             String?
  cardType            String?
  cardExpiryMonth     String?
  cardExpiryYear      String?
  cardPIN             String?
  redirectUrl         String?
  authorizationMode   String?
  transactionId       String?
  ebmReference        String?
  flwStatus           String?
  appFee              Float?
  merchantFee         Float?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paidAt              DateTime?
  DeliveryOTP         DeliveryOTP?
  cart                Cart?                @relation(fields: [cartId], references: [id])
  logistics           Admin?               @relation("LOGISTICS", fields: [logisticsId], references: [id])
  affiliator          Affiliator?          @relation(fields: [orderedBy], references: [id])
  paymentMethodConfig PaymentMethodConfig? @relation(fields: [paymentMethod], references: [name])
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  Voucher             Voucher?             @relation(fields: [voucherId], references: [id])
  OrderDelivery       OrderDelivery?
  orderItems          OrderItem[]
  VoucherTransaction  VoucherTransaction[]

  @@index([restaurantId])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([txRef])
  @@index([flwRef])
  @@index([transactionId])
  @@index([flwStatus])
  @@index([cartId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Float
  unitPrice   Float
  subtotal    Float
  unit        String
  images      String[]
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model DeliveryOTP {
  id        String   @id @default(uuid())
  orderId   String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([expiresAt])
}

model OrderDelivery {
  id           String         @id @default(uuid())
  orderId      String         @unique
  logisticsId  String
  status       DeliveryStatus @default(PENDING)
  otpVerified  Boolean        @default(false)
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  logistics    Admin          @relation(fields: [logisticsId], references: [id])
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([logisticsId])
  @@index([status])
}

model Wallet {
  id                        String              @id @default(uuid())
  restaurantId              String?             @unique
  traderId                  String?             @unique
  balance                   Float               @default(0)
  pendingApprovedAmount     Float               @default(0)
  commissionEarned          Float               @default(0)
  commission                Float               @default(3.0)
  commissionMode            CommissionMode      @default(NORMAL)
  commissionModeChangedAt   DateTime?
  lastMonthlyCommissionDate DateTime?
  totalDeposited            Float               @default(0)
  pendingWithdrawBalance    Float               @default(0)
  pendingWithdrawCommission Float               @default(0)
  totalWithdrawn            Float               @default(0)
  canTradeOnBehalf          Boolean             @default(false)
  delegationStatus          DelegationStatus    @default(NORMAL)
  delegationRequestedAt     DateTime?
  delegationApprovedAt      DateTime?
  delegationApprovedBy      String?
  delegationAcceptedAt      DateTime?
  currency                  String              @default("RWF")
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  delegationHistories       DelegationHistory[]
  restaurant                Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  trader                    Admin?              @relation("TraderWallet", fields: [traderId], references: [id], onDelete: Cascade)
  transactions              WalletTransaction[]

  @@index([restaurantId])
  @@index([traderId])
  @@index([isActive])
}

model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String
  adminId           String?
  restaurantId      String?
  affiliatorId      String?
  traderId          String?
  type              WalletTransactionType
  amount            Float
  previousBalance   Float
  newBalance        Float
  description       String?
  reference         String?
  flwTxRef          String?               @unique
  flwRef            String?
  flwStatus         String?
  flwMessage        String?
  paymentMethod     String?
  externalTxId      String?
  withdrawType      WithdrawType?
  accountNumber     String?
  accountName       String?
  otp               String?
  otpExpiresAt      DateTime?
  otpVerified       Boolean?              @default(false)
  approvedBy        String?
  approvedAt        DateTime?
  paymentProofImage String?
  isReversed        Boolean               @default(false)
  status            TransactionStatus     @default(PENDING)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  admin             Admin?                @relation("WalletTransactionAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  affiliator        Affiliator?           @relation(fields: [affiliatorId], references: [id], onDelete: Cascade)
  approver          Admin?                @relation("WithdrawApprover", fields: [approvedBy], references: [id])
  restaurant        Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  trader            Admin?                @relation("TraderTransactions", fields: [traderId], references: [id], onDelete: Cascade)
  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([flwTxRef])
  @@index([adminId])
  @@index([restaurantId])
  @@index([affiliatorId])
  @@index([traderId])
}

model POSSale {
  id            String     @id @default(uuid())
  restaurantId  String
  totalAmount   Float
  paymentMethod String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
}

model SubscriptionPlan {
  id                 String                   @id @default(uuid())
  name               String                   @unique
  description        String?
  price              Float
  voucherAccess      Boolean  @default(false)
  voucherPaymentDays Int      @default(30) // Number of days for voucher payment
  loanAccess         Boolean  @default(false) // Whether plan includes loan access
  loanProviderId     String? // Which loan provider this plan works with (for loans)
  freeDelivery       Boolean  @default(false)
  stablePricing      Boolean  @default(false)
  receiveEBM         Boolean  @default(false)
  advertisingAccess  Boolean  @default(false)
  otherServices      Boolean  @default(false)
  duration           Int // Duration in days
  features           String[] // Array of features included in the plan
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  subscriptions RestaurantSubscription[]

  loanProvider LoanProvider? @relation(fields: [loanProviderId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([name])
  @@index([loanProviderId])
}

model RestaurantSubscription {
  id                String                @id @default(uuid())
  restaurantId      String?
  farmerId          String?
  planId            String
  status            SubscriptionStatus    @default(ACTIVE)
  startDate         DateTime              @default(now())
  endDate           DateTime
  autoRenew         Boolean               @default(true)
  paymentMethod     String?
  paymentStatus     PaymentStatus      @default(PENDING)
  expiryWarningSent Boolean            @default(false)

  // Loan access approval tracking (loan access is part of this single subscription)
  loanAccessApprovedAt DateTime?
  loanAccessNotes      String?

  // Payment tracking
  txRef         String? @unique
  flwRef        String?
  transactionId String?
  amountPaid    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  restaurant Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer     Farmer?               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments   SubscriptionPayment[]
  history    SubscriptionHistory[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model SubscriptionPayment {
  id             String                 @id @default(uuid())
  subscriptionId String
  amount         Float
  paymentMethod  String
  paymentStatus  PaymentStatus          @default(PENDING)
  txRef          String?                @unique
  flwRef         String?
  transactionId  String?
  flwStatus      String?
  flwMessage     String?
  paidAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentStatus])
  @@index([txRef])
}

model SubscriptionHistory {
  id             String                 @id @default(uuid())
  subscriptionId String
  action         SubscriptionAction
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus?
  oldPlanId      String?
  newPlanId      String?
  reason         String?
  performedBy    String?
  createdAt      DateTime               @default(now())
  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([action])
  @@index([createdAt])
}

model Voucher {
  id                 String               @id @default(uuid())
  voucherCode        String               @unique
  voucherType        VoucherType
  discountPercentage Float // 10, 20, 50, 80, 100

  // Credit limits
  creditLimit Float
  currency    VoucherCurrency @default(RWF)

  // Credit tracking
  totalCredit     Float
  usedCredit      Float @default(0)
  remainingCredit Float

  // Payment tracking
  paidAmount      Float @default(0)
  remainingAmount Float @default(0)

  // Commission tracking
  commission Float @default(0) // Commission amount saved when voucher is used

  // Status and dates
  status     VoucherStatus @default(ACTIVE)
  expiryDate DateTime?
  issuedDate DateTime      @default(now())
  approvedBy String?

  // Relations
  restaurantId String?
  farmerId     String?
  loanId       String?

  // Repayment days
  repaymentDays Int @default(7)

  // Service fee
  serviceFeeRate Float @default(0) // 0% service fee

  // Timestamps
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  restaurant   Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  farmer       Farmer?              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  loan         LoanApplication?     @relation(fields: [loanId], references: [id])
  approver     Admin?               @relation(fields: [approvedBy], references: [id])
  transactions VoucherTransaction[]
  repayments   VoucherRepayment[]
  penalties    VoucherPenalty[]
  orders       Order[]
  walletTransfers WalletTransfer[]
  creditTopUps  VoucherCreditTopUp[]

  @@index([restaurantId])
  @@index([farmerId])
  @@index([status])
  @@index([voucherCode])
  @@index([loanId])
}

model LoanApplication {
